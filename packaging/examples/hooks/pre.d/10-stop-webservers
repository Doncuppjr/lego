#!/usr/bin/env bash
set -euo pipefail

# Stop common listeners that may occupy TCP/443 for TLS-ALPN-01.
# Copy to /etc/lego/hooks/pre.d/10-stop-webservers and chmod +x to enable.

for service in nginx apache2 httpd; do
  if systemctl list-unit-files "${service}.service" >/dev/null 2>&1; then
    if systemctl is-active --quiet "$service"; then
      systemctl stop "$service"
    fi
  fi
done
